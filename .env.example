# ---- Database ----
POSTGRES_DB=support_agent_ai
POSTGRES_USER=support_agent
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Django ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---- Default admin user (created automatically on first start) ----
DJANGO_SUPERUSER_USERNAME=admin@soham.com
DJANGO_SUPERUSER_EMAIL=admin@soham.com
DJANGO_SUPERUSER_PASSWORD=change-me

# ---- AI chat ----
# Which model answers by default: gemini, grok, openai, ollama, or fake (demo mode, needs no key).
# After editing this file, apply the change with:  docker compose up -d
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROK_API_KEY=
GROK_MODEL=grok-4.3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Ollama runs on your PC (outside Docker). Make it empty to hide Ollama from the chat.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.2

# Test messages allowed per user per day, and how similar a passage must be to be used (0 to 1)
CHAT_DAILY_LIMIT=50
RAG_MIN_SIMILARITY=0.75
